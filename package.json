{
  "name": "@senmoxiu/dsh-git-heatmap",
  "version": "0.1.0",
  "description": "DSH Web GUI plugin: render this machine's local git commits as a GitHub-style contribution heatmap, aggregated across many repositories",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "git",
    "heatmap",
    "contribution",
    "visualization"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3",
    "react": "^18.2.0"
  }
}
